{
  "name": "jack-codex",
  "version": "1.0.6",
  "private": true,
  "description": "Jack Codex 单平台桌面配置工具",
  "author": "Jack",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "npm run test:static && npm run test:ops && npm run test:purge && npm run test:installer",
    "test:static": "node tests/validate-package.mjs",
    "test:ops": "python3 tests/test-jack-ops.py",
    "test:purge": "node tests/test-jack-purge.mjs",
    "test:installer": "powershell -NoLogo -NoProfile -NonInteractive -File tests/test-installer.ps1",
    "dist": "node scripts/build.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.jack.codex",
    "productName": "Jack Codex 工具",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "dist/**/*", "package.json", "variant.json"],
    "extraResources": [
      { "from": "install.ps1", "to": "install.ps1" },
      { "from": "scripts/clear-injected-prompts.ps1", "to": "scripts/clear-injected-prompts.ps1" },
      { "from": "scripts/jack-purge-proxy.mjs", "to": "scripts/jack-purge-proxy.mjs" },
      { "from": "scripts/start-jack-purge.ps1", "to": "scripts/start-jack-purge.ps1" },
      { "from": "scripts/启动破甲.cmd", "to": "scripts/start-jack-purge.cmd" },
      { "from": "jack-codex-v1.md", "to": "jack-codex-v1.md" },
      { "from": "codex-skills", "to": "codex-skills" },
      { "from": "build/icon-256.png", "to": "icon.png" }
    ],
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [{ "target": "tar.gz", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "jack-codex"
    },
    "artifactName": "Jack-Codex-${os}-${version}.${ext}"
  }
}
